# ==============================================================================
# FastAPI Core Settings
# ==============================================================================
PROJECT_NAME="Kerdion"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=your_super_secret_jwt_signing_key_change_me_in_production

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=kerdion_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL used by SQLAlchemy / Alembic (constructed dynamically or explicitly)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_here@postgres:5432/kerdion_db

# ==============================================================================
# Redis Cache & Broker Configuration
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================================================================
# Celery Configuration
# ==============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==============================================================================
# Third-Party API Keys (Optional for local testing, required for live ingestion)
# ==============================================================================
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret